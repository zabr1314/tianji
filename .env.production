# 生产环境配置文件
# 注意：部署时需要将这些环境变量配置到您的部署平台

# Supabase configuration for production
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=

# DeepSeek AI API
DEEPSEEK_API_KEY=

# Payment Integration (Zpay)
ZPAY_PID=
ZPAY_PKEY=

# Site Configuration - Vercel自动域名
NEXT_PUBLIC_SITE_URL="https://tianji-ai.vercel.app"

# Node.js Environment
NODE_ENV=production
